package main

import (
	"context"
	"crypto/rand"
	"crypto/rsa"
	"crypto/tls"
	"crypto/x509"
	"crypto/x509/pkix"
	"encoding/pem"
	"math/big"
	"testing"
	"time"

	"github.com/odvcencio/goetrope/pkg/transcode"
	"github.com/odvcencio/goetrope/pkg/worker"
	transcodev1 "github.com/odvcencio/goetrope/proto/transcodev1"
	"github.com/stretchr/testify/require"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/credentials"
	"google.golang.org/grpc/status"
)

func bothWorkerCertificate(t *testing.T) (tls.Certificate, *x509.CertPool) {
	t.Helper()
	key, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		t.Fatal(err)
	}
	template := &x509.Certificate{
		SerialNumber: big.NewInt(1),
		Subject:      pkix.Name{CommonName: "worker.test"},
		DNSNames:     []string{"worker.test"},
		NotBefore:    time.Now().Add(-time.Minute),
		NotAfter:     time.Now().Add(time.Hour),
		KeyUsage:     x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment,
		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
	}
	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
	certificate, err := tls.X509KeyPair(certPEM, keyPEM)
	if err != nil {
		t.Fatal(err)
	}
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM(certPEM) {
		t.Fatal("append test CA")
	}
	return certificate, roots
}

@serial
unit "both worker trusted listener" {
	then "binds TLS admission and shuts down the loopback listener" {
		certificate, roots := bothWorkerCertificate(t)
		protocol := worker.CurrentWorkerProtocol()
		credential := []byte("both-worker-credential")
		runtime, err := startTrustedWorkerGRPCListener("127.0.0.1:0", worker.TrustedWorkerGRPCServerConfig{
			Transport: worker.TrustedTransportConfig{
				Certificate:           certificate,
				Credential:            credential,
				Protocol:              protocol,
				RequireCanaryPassed:   true,
				RequireCachePushReady: true,
			},
			Coordinator: transcode.NewCoordinator(),
			CacheRoot:   t.TempDir(),
		})
		require.NoError(t, err)
		defer runtime.stop()

		clientTLS, err := worker.NewClientTLS(worker.TrustedTransportConfig{RootCAs: roots, ServerName: "worker.test"})
		require.NoError(t, err)
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		conn, err := grpc.DialContext(ctx, runtime.listener.Addr().String(), grpc.WithTransportCredentials(credentials.NewTLS(clientTLS)), grpc.WithBlock())
		require.NoError(t, err)
		client := transcodev1.NewTranscodeServiceClient(conn)
		missing, err := client.Register(worker.WithTrustedMetadata(ctx, credential, protocol), &transcodev1.WorkerInfo{Label: "missing-admission"})
		expect missing is_nil
		expect status.Code(err) == codes.FailedPrecondition
		registered, err := client.Register(worker.WithTrustedMetadata(ctx, credential, protocol, true, true), &transcodev1.WorkerInfo{Label: "both-loopback"})
		require.NoError(t, err)
		expect registered.GetWorkerId() != ""
		runtime.stop()
		_, err = client.Register(worker.WithTrustedMetadata(ctx, credential, protocol, true, true), &transcodev1.WorkerInfo{Label: "after-stop"})
		expect err != nil
		conn.Close()
	}
}
