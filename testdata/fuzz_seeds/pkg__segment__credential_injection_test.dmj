package segment

import (
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"strings"
	"testing"
)

unit "disabled segment egress credential boundary" {
	given "explicitly injected bucket credentials" {
		accessMarker := "SEGMENT_ACCESS_MARKER_17"
		secretMarker := "SEGMENT_SECRET_MARKER_18"
		access := []byte(accessMarker)
		secret := []byte(secretMarker)
		uploader, err := NewUploader(UploaderConfig{
			Endpoint: "https://objects.example.invalid",
			Bucket: "segments",
			AccessKey: access,
			SecretKey: secret,
		})
		for i := range access { access[i] = 0 }
		for i := range secret { secret[i] = 0 }

		then "S3 egress fails unavailable without retaining an authority" {
			expect uploader == nil
			expect errors.Is(err, ErrSegmentEgressUnavailable)
			expect err.Error() == "feature_unavailable"
		}

		then "configuration rendering remains redacted" {
			redactionConfig := UploaderConfig{AccessKey: []byte(accessMarker), SecretKey: []byte(secretMarker)}
			configJSON, configJSONErr := json.Marshal(redactionConfig)
			rendered := fmt.Sprintf("%v %+v %#v %s", redactionConfig, redactionConfig, redactionConfig, configJSON)
			expect configJSONErr == nil
			expect strings.Contains(rendered, "[redacted]")
			reject strings.Contains(rendered, accessMarker)
			reject strings.Contains(rendered, secretMarker)
			reject strings.Contains(rendered, base64.StdEncoding.EncodeToString([]byte(accessMarker)))
			reject strings.Contains(rendered, base64.StdEncoding.EncodeToString([]byte(secretMarker)))
		}
	}
}
