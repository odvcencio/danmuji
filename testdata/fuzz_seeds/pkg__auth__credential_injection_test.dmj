package auth

import (
	"strings"
	"testing"
)

unit "Discord OAuth credential ownership" {
	given "an explicitly injected client secret" {
		marker := "DISCORD_CLIENT_MARKER_42"
		caller := []byte(marker)
		service := NewDiscordService(DiscordConfig{
			ClientID: "client",
			RedirectURI: "http://127.0.0.1/callback",
			GuildID: "123",
			SessionKey: []byte("session-key-material"),
		}, caller)
		for i := range caller {
			caller[i] = 0
		}

		then "the service retains a private copy" {
			expect service.Configured()
			expect string(service.clientSecret) == marker
		}

		when "the service closes" {
			service.Close()

			then "the client credential is erased" {
				reject service.Configured()
				expect len(service.clientSecret) == 0
				reject strings.Contains(service.GoString(), marker)
			}
		}
	}
}
