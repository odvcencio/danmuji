package api_test

import (
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/odvcencio/goetrope/pkg/api"
	"github.com/odvcencio/goetrope/pkg/library"
	"github.com/odvcencio/goetrope/pkg/randomchannel"
	"github.com/odvcencio/goetrope/pkg/streamtoken"
)

type stubRandomChannelService struct {
	summary *randomchannel.Summary
	err     error
}

func (s stubRandomChannelService) Summary(context.Context) (*randomchannel.Summary, error) {
	return s.summary, s.err
}

type stubRandomChannelRegistry struct {
	summaries []*randomchannel.Summary
	err       error
}

func (s stubRandomChannelRegistry) Summaries(context.Context) ([]*randomchannel.Summary, error) {
	return s.summaries, s.err
}

func (s stubRandomChannelRegistry) Summary(_ context.Context, alias string) (*randomchannel.Summary, bool, error) {
	if s.err != nil {
		return nil, false, s.err
	}
	for _, summary := range s.summaries {
		if summary != nil && summary.Alias == alias {
			return summary, true, nil
		}
	}
	return nil, false, nil
}

type stubChannelMediaStore struct {
	item  *library.MediaItem
	items map[int64]*library.MediaItem
}

func (s stubChannelMediaStore) GetItem(_ context.Context, id int64) (*library.MediaItem, error) {
	if s.items != nil {
		return s.items[id], nil
	}
	return s.item, nil
}

unit "Random channel API wrapper" {
	given "a wrapped router with a channel summary" {
		handler := api.WithUnsafeRandomChannelWithoutStreamAuth(http.NotFoundHandler(), stubRandomChannelService{
			summary: &randomchannel.Summary{
				Alias:            randomchannel.Alias,
				Name:             randomchannel.ChannelName,
				RoomCode:         randomchannel.RoomCode,
				ViewerLink:       "/watch/1",
				WebSocketPath:    "/api/theatre/CHAN01/ws",
				CurrentItemIndex: 0,
				AccessMode:       "public",
				CurrentPosition:  101,
				Playing:          true,
				ViewerDelay:      8,
				NetworkIdle:      false,
				Playlist: []randomchannel.PlaylistEntry{
					{MediaItemID: 11, Title: "Inland Empire", Year: 2006, DurationMS: 10740000},
					{MediaItemID: 22, Title: "New Jack City", Year: 1991, DurationMS: 6060000},
				},
			},
		}, stubChannelMediaStore{
			item: &library.MediaItem{
				ID:         11,
				Title:      "Inland Empire",
				Year:       2006,
				DurationMs: 10740000,
				Streams: []library.Stream{
					{StreamIndex: 0, StreamType: "video", Codec: "h264", Width: 1920, Height: 1080},
					{StreamIndex: 1, StreamType: "audio", Codec: "aac", Language: "eng", Channels: 2, IsDefault: true},
					{StreamIndex: 2, StreamType: "subtitle", CodecTag: "sidecar:srt", Language: "eng"},
				},
			},
		})

		when "requesting the channel summary" {
			req := httptest.NewRequest("GET", "/api/channel/1", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns ok" {
				expect rec.Code == 200
			}

			then "returns the stable room alias" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				expect body["room_code"] == randomchannel.RoomCode
			}

			then "includes current item playback metadata for no-reload player handoffs" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				current, _ := body["current_item"].(map[string]any)
				expect current["media_item_id"] == float64(11)
				expect strings.Contains(current["src"].(string), "/stream/11/master.m3u8")
				expect strings.Contains(current["src"].(string), "position=93.000")
				audio, _ := current["audio_tracks"].([]any)
				subtitles, _ := current["subtitle_tracks"].([]any)
				expect len(audio) == 1
				expect len(subtitles) == 1
				expect current["subtitle_track"] == ""
				firstSubtitle, _ := subtitles[0].(map[string]any)
				expect firstSubtitle["selected"] == false
			}
		}

		when "requesting the channel playlist" {
			req := httptest.NewRequest("GET", "/api/channel/1/playlist", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns ok" {
				expect rec.Code == 200
			}

			then "returns playlist items" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				items, _ := body["items"].([]any)
				expect len(items) == 2
			}
		}

		when "requesting the retired session summary alias" {
			req := httptest.NewRequest("GET", "/api/session/1", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns not found" {
				expect rec.Code == 404
			}
		}

		when "requesting the retired session playlist alias" {
			req := httptest.NewRequest("GET", "/api/session/1/playlist", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns not found" {
				expect rec.Code == 404
			}
		}

		when "requesting an unknown alias" {
			req := httptest.NewRequest("GET", "/api/channel/9", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns not found" {
				expect rec.Code == 404
			}
		}
	}
}

unit "Random channel API subtitle payload contract" {
	given "a channel handoff from a subtitled item to a trackless item" {
		handler := api.WithUnsafeRandomChannelWithoutStreamAuth(http.NotFoundHandler(), stubRandomChannelService{
			summary: &randomchannel.Summary{
				Alias:            randomchannel.Alias,
				Name:             randomchannel.ChannelName,
				RoomCode:         randomchannel.RoomCode,
				ViewerLink:       "/watch/1",
				WebSocketPath:    "/api/theatre/CHAN01/ws",
				CurrentItemIndex: 0,
				Playlist: []randomchannel.PlaylistEntry{
					{MediaItemID: 11, Title: "Subtitled Feature", Year: 2001, DurationMS: 60000},
					{MediaItemID: 22, Title: "Trackless Feature", Year: 2002, DurationMS: 61000},
				},
			},
		}, stubChannelMediaStore{
			items: map[int64]*library.MediaItem{
				11: {
					ID:         11,
					Title:      "Subtitled Feature",
					DurationMs: 60000,
					Streams: []library.Stream{
						{StreamIndex: 1, StreamType: "audio", Codec: "aac", Language: "eng", Channels: 2, IsDefault: true},
						{StreamIndex: 2, StreamType: "subtitle", CodecTag: "sidecar:srt", Language: "eng"},
					},
				},
				22: {
					ID:         22,
					Title:      "Trackless Feature",
					DurationMs: 61000,
					Streams: []library.Stream{
						{StreamIndex: 1, StreamType: "audio", Codec: "aac", Language: "eng", Channels: 2, IsDefault: true},
					},
				},
			},
		})

		when "requesting the channel summary" {
			req := httptest.NewRequest("GET", "/api/channel/1", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "serializes explicit empty subtitle tracks for the trackless next item" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				current, _ := body["current_item"].(map[string]any)
				next, _ := body["next_item"].(map[string]any)
				currentSubtitles, _ := current["subtitle_tracks"].([]any)
				nextSubtitles, nextHasSubtitles := next["subtitle_tracks"].([]any)
				expect rec.Code == 200
				expect len(currentSubtitles) == 1
				expect nextHasSubtitles
				expect len(nextSubtitles) == 0
				expect current["subtitle_track"] == ""
				expect strings.Contains(rec.Body.String(), `"subtitle_tracks":[]`)
				expect strings.Contains(rec.Body.String(), `"subtitle_track":""`)
			}
		}
	}
}

unit "Random channel registry API wrapper" {
	given "a wrapped router with movie and show channels" {
		handler := api.WithRandomChannelRegistryStreamMinter(http.NotFoundHandler(), stubRandomChannelRegistry{
			summaries: []*randomchannel.Summary{
				{
					Alias:    "1",
					Name:     "Random Movies",
					RoomCode: "CHAN01",
					Playlist: []randomchannel.PlaylistEntry{
						{MediaItemID: 11, Title: "Inland Empire", Year: 2006, DurationMS: 10740000},
					},
				},
				{
					Alias:            "2",
					Name:             "Random Shows",
					RoomCode:         "SHOW01",
					ViewerLink:       "/watch/2",
					WebSocketPath:    "/api/theatre/SHOW01/ws",
					CurrentItemIndex: 0,
					Program: randomchannel.ProgramSummary{
						ID:           "twin-peaks-marathon",
						Name:         "Twin Peaks Marathon",
						Kind:         randomchannel.ProgramKindSeriesMarathon,
						ContentKind:  randomchannel.ContentKindShows,
						SeriesID:     9,
						SeriesTitle:  "Twin Peaks",
						SubtitleMode: "required",
					},
					Theme: randomchannel.ThemeSummary{
						ID:          "black-lodge",
						Name:        "Black Lodge",
						CSSClass:    "theme-black-lodge",
						AccentColor: "#b91c1c",
					},
					Playlist: []randomchannel.PlaylistEntry{
						{MediaItemID: 33, Title: "Twin Peaks - S01E01", Year: 1990, DurationMS: 5640000},
						{MediaItemID: 44, Title: "Twin Peaks - S01E02", Year: 1990, DurationMS: 5520000},
					},
				},
			},
		}, streamtoken.NewUnsafeMinterFromRawStringForTest("registry-test-secret", time.Hour), stubChannelMediaStore{
			item: &library.MediaItem{
				ID:         33,
				Title:      "Twin Peaks",
				Year:       1990,
				DurationMs: 5640000,
				Streams: []library.Stream{
					{StreamIndex: 1, StreamType: "audio", Codec: "aac", Language: "eng", Channels: 2, IsDefault: true},
					{StreamIndex: 2, StreamType: "subtitle", Codec: "hdmv_pgs_subtitle", CodecTag: "pgs", Language: "eng", IsDefault: true},
					{StreamIndex: 3, StreamType: "subtitle", Codec: "subrip", CodecTag: "subrip", Language: "eng"},
					{StreamIndex: 4, StreamType: "subtitle", CodecTag: "sidecar:srt", Language: "eng"},
				},
			},
		})

		when "requesting the channel list" {
			req := httptest.NewRequest("GET", "/api/channel", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns both configured channels in registry order" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				items, _ := body["items"].([]any)
				expect rec.Code == 200
				expect len(items) == 2
				first, _ := items[0].(map[string]any)
				second, _ := items[1].(map[string]any)
				program, _ := second["program"].(map[string]any)
				theme, _ := second["theme"].(map[string]any)
				expect first["alias"] == "1"
				expect second["alias"] == "2"
				expect program["id"] == "twin-peaks-marathon"
				expect theme["id"] == "black-lodge"
			}
		}

		when "requesting the show channel summary" {
			req := httptest.NewRequest("GET", "/api/channel/2", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns the show identity and track metadata" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				current, _ := body["current_item"].(map[string]any)
				subtitles, _ := current["subtitle_tracks"].([]any)
				program, _ := body["program"].(map[string]any)
				theme, _ := body["theme"].(map[string]any)
				expect rec.Code == 200
				expect body["room_code"] == "SHOW01"
				expect program["kind"] == "series_marathon"
				expect program["series_title"] == "Twin Peaks"
				expect theme["css_class"] == "theme-black-lodge"
				expect current["media_item_id"] == float64(33)
				expect current["subtitle_track"] == ""
				expect len(subtitles) == 2
				firstSubtitle, _ := subtitles[0].(map[string]any)
				secondSubtitle, _ := subtitles[1].(map[string]any)
				expect firstSubtitle["id"] == "3"
				expect secondSubtitle["id"] == "4"
				expect firstSubtitle["selected"] == false
				expect secondSubtitle["selected"] == false
				reject firstSubtitle["bitmap"] == true
				reject secondSubtitle["bitmap"] == true
			}
		}

		when "requesting the show channel playlist" {
			req := httptest.NewRequest("GET", "/api/channel/2/playlist", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns only the show playlist" {
				var body map[string]any
				_ = json.Unmarshal(rec.Body.Bytes(), &body)
				items, _ := body["items"].([]any)
				expect rec.Code == 200
				expect len(items) == 2
			}
		}

		when "requesting an unknown registry alias" {
			req := httptest.NewRequest("GET", "/api/channel/99", nil)
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, req)

			then "returns not found" {
				expect rec.Code == 404
			}
		}
	}
}
