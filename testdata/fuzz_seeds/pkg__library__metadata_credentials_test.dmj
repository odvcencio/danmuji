package library

import (
	"fmt"
	"strings"
	"testing"
)

unit "metadata credential ownership" {
	given "an explicitly injected TMDB token" {
		marker := "TMDB_CREDENTIAL_MARKER_91"
		caller := []byte(marker)
		resolver, err := NewMetadataResolver(MetadataResolverConfig{TMDBReadToken: caller})
		for i := range caller {
			caller[i] = 0
		}
		provider := resolver.providers[0].(*tmdbProvider)

		then "the resolver owns a private redacted copy" {
			expect err == nil
			expect string(provider.token) == marker
			reject strings.Contains(fmt.Sprintf("%+v", resolver), marker)
		}

		when "the resolver closes" {
			resolver.Close()

			then "the provider token is erased" {
				expect len(provider.token) == 0
			}
		}
	}
}
