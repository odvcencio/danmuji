package config

import (
	"bytes"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func encodedCredentialMaster() string {
	return "active:" + base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x31}, 32))
}

@serial
unit "typed credential source selectors" {
	then "a referenced legacy environment target is consumed only through its source reference" {
		t.Chdir(t.TempDir())
		t.Setenv("XDG_CONFIG_HOME", t.TempDir())
		t.Setenv("GOETROPE_POSTGRES_DSN_SOURCE", "env:DATABASE_URL")
		t.Setenv("DATABASE_URL", "postgres://typed-source")
		result, err := Load(LoadOptions{})
		expect err == nil
		expect result.Config.Postgres.DSNSource.String() == "env:DATABASE_URL"
	}

	then "an unreferenced legacy credential environment variable fails without reflecting its value" {
		t.Chdir(t.TempDir())
		t.Setenv("XDG_CONFIG_HOME", t.TempDir())
		marker := "UNREFERENCED_DATABASE_MARKER"
		t.Setenv("DATABASE_URL", marker)
		_, err := Load(LoadOptions{})
		expect err != nil
		expect strings.Contains(err.Error(), "DATABASE_URL")
		reject strings.Contains(err.Error(), marker)
	}

	then "raw credential TOML keys are rejected by field name without reflecting their value" {
		dir := t.TempDir()
		t.Chdir(dir)
		t.Setenv("XDG_CONFIG_HOME", t.TempDir())
		marker := "RAW_TOML_SECRET_MARKER"
		contents := "[discord]\nclient_secret = \"" + marker + "\"\n"
		err := os.WriteFile(filepath.Join(dir, "goetrope.toml"), []byte(contents), 0o600)
		expect err == nil
		_, loadErr := Load(LoadOptions{})
		expect loadErr != nil
		expect strings.Contains(loadErr.Error(), "discord.client_secret")
		reject strings.Contains(loadErr.Error(), marker)
	}

}

unit "environment-backed source references are unique" {
	then "two fields cannot consume the same environment target" {
		cfg := Defaults()
		cfg.Security.Runtime = RuntimeDevelopment
		cfg.Postgres.DSNSource = "env:SHARED_CREDENTIAL"
		cfg.Auth.AdminKeySource = "env:SHARED_CREDENTIAL"
		err := Validate(Normalize(cfg))
		expect err != nil
		expect strings.Contains(err.Error(), "auth.admin_key_source")
		expect strings.Contains(err.Error(), "postgres.dsn_source")
	}

	then "a worker credential cannot reuse another credential environment target" {
		cfg := Defaults()
		cfg.Security.Runtime = RuntimeDevelopment
		cfg.Worker.Mode = WorkerRemote
		cfg.Postgres.DSNSource = "env:SHARED_WORKER_CREDENTIAL"
		cfg.Worker.CredentialSource = "env:SHARED_WORKER_CREDENTIAL"
		err := Validate(Normalize(cfg))
		expect err != nil
		expect strings.Contains(err.Error(), "worker.credential_source")
		expect strings.Contains(err.Error(), "postgres.dsn_source")
	}
}

@serial
unit "prepared runtime owns and redacts credential buffers" {
	then "all configured sources resolve once and transfer or erase predictably" {
		masterMarker := encodedCredentialMaster()
		dsnMarker := "postgres://prepared-runtime-marker"
		adminMarker := "prepared-admin-marker"
		t.Setenv("PREPARED_MASTER", masterMarker)
		t.Setenv("PREPARED_DSN", dsnMarker)
		t.Setenv("PREPARED_ADMIN", adminMarker)
		cfg := Defaults()
		cfg.Security.MasterKeySource = "env:PREPARED_MASTER"
		cfg.Postgres.DSNSource = "env:PREPARED_DSN"
		cfg.Auth.AdminKeySource = "env:PREPARED_ADMIN"
		cfg = Normalize(cfg)
		runtime, err := PrepareRuntime(cfg)
		expect err == nil
		_, masterExists := os.LookupEnv("PREPARED_MASTER")
		_, dsnExists := os.LookupEnv("PREPARED_DSN")
		_, adminExists := os.LookupEnv("PREPARED_ADMIN")
		reject masterExists
		reject dsnExists
		reject adminExists

		adminOwned := runtime.credentials[CredentialAdminKey]
		adminCopy := runtime.CopyCredential(CredentialAdminKey)
		dsnTaken := runtime.TakeCredential(CredentialPostgresDSN)
		runtimeJSON, jsonErr := json.Marshal(runtime)
		expect jsonErr == nil
		rendered := fmt.Sprintf("%v %+v %#v %s", runtime, runtime, runtime, runtimeJSON)
		reject strings.Contains(rendered, masterMarker)
		reject strings.Contains(rendered, dsnMarker)
		reject strings.Contains(rendered, adminMarker)
		takenKeyring := runtime.TakeKeyring()
		keyHandle := takenKeyring.Active(KeyCSRF)
		runtime.Close()
		runtime.Close()
		expect bytes.Equal(adminOwned, make([]byte, len(adminOwned)))
		expect string(adminCopy) == adminMarker
		expect string(dsnTaken) == dsnMarker
		reject bytes.Equal(keyHandle.Bytes(), make([]byte, len(keyHandle.Bytes())))
		takenKeyring.Destroy()
		expect bytes.Equal(keyHandle.Bytes(), make([]byte, len(keyHandle.Bytes())))
		erase(adminCopy)
		erase(dsnTaken)
	}

	then "a later resolution error erases every earlier credential buffer" {
		cfg := Defaults()
		cfg.Security.Runtime = RuntimeDevelopment
		cfg.Postgres.DSNSource = "file:/first"
		cfg.Discord.ClientSecretSource = "file:/second"
		cfg = Normalize(cfg)
		first := []byte("first-secret-buffer")
		second := []byte("second-partial-buffer")
		calls := 0
		resolveErr := errors.New("resolver stopped")
		resolver := func(ref SecretSourceRef) ([]byte, error) {
			calls++
			if ref == "file:/first" {
				return first, nil
			}
			return second, resolveErr
		}
		runtime, err := prepareRuntimeWith(cfg, resolver)
		expect err != nil
		expect runtime is_nil
		expect calls == 2
		expect bytes.Equal(first, make([]byte, len(first)))
		expect bytes.Equal(second, make([]byte, len(second)))
	}
}
