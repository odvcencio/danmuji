package discordbot

import (
	"fmt"
	"errors"
	"context"
	"strings"
	"testing"
)

unit "Discord bot credential ownership" {
	given "an explicitly injected bot token" {
		marker := "DISCORD_BOT_MARKER_73"
		caller := []byte(marker)
		service, err := NewWithBotToken(Config{}, caller, nil, nil, nil, nil, nil)
		for i := range caller { caller[i] = 0 }

		then "the service owns a private redacted copy" {
			expect err == nil
			expect service.botTokenConfigured()
			reject service.GatewayConfigured()
			reject strings.Contains(fmt.Sprintf("%+v", service), marker)
		}

		then "the gateway fails unavailable without opening a socket" {
			expect errors.Is(service.Run(context.Background()), ErrDiscordGatewayUnavailable)
		}

		when "the service closes" {
			service.Close()

			then "the bot credential is unavailable" {
				reject service.botTokenConfigured()
				reject service.GatewayConfigured()
			}
		}
	}
}
