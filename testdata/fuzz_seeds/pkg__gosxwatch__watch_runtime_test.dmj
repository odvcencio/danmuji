unit "GoSX watch and party routes bind theatre hub mode" {
	goSourceFiles, globErr := filepath.Glob("*.go")
	expect globErr == nil
	dataSource := ""
	for _, file := range goSourceFiles {
		if strings.HasSuffix(file, "_test.go") {
			continue
		}
		sourceBytes, sourceErr := os.ReadFile(file)
		expect sourceErr == nil
		dataSource += string(sourceBytes)
	}
	fileModuleBytes, fileModuleErr := os.ReadFile("filemodules.go")
	expect fileModuleErr == nil
	fileModules := string(fileModuleBytes)
	then "adds a hub path without replacing the existing websocket and player sync paths" {
		expect strings.Contains(dataSource, "\"websocket_path\": mountPath(videoSyncPath(playbackRoomCode, summary.WebSocketPath))")
		expect strings.Contains(dataSource, "\"hub_path\":       mountPath(videoHubPath(playbackRoomCode, summary.WebSocketPath))")
		expect strings.Contains(dataSource, "\"websocket_path\": mountPath(fmt.Sprintf(")
		expect strings.Contains(dataSource, "\"hub_path\":    mountPath(videoHubPath(displayCode, \"\"))")
		expect strings.Contains(dataSource, "\"sync_href\":            videoSyncPath(roomCode, explicitSyncPath)")
		expect strings.Contains(dataSource, "func videoHubPath(roomCode, explicitPath string) string")
		expect strings.Contains(dataSource, "[2]string{\"protocol\", \"gosx-hub\"}")
	}
	then "binds inbound theatre events and outbound buffer readiness to shared signals" {
		expect strings.Contains(fileModules, "ctx.Runtime().BindHub(\"goetrope-watch\", hubPath")
		expect strings.Contains(fileModules, "{Event: \"sync_heartbeat\", Signal: watchHubHeartbeatSignal}")
		expect strings.Contains(fileModules, "{Event: \"sync_prepare\", Signal: watchHubEventSignal}")
		expect strings.Contains(fileModules, "{Event: \"sync_play\", Signal: watchHubEventSignal}")
		expect strings.Contains(fileModules, "{Event: \"pause\", Signal: watchHubEventSignal}")
		expect strings.Contains(fileModules, "{Event: \"seek\", Signal: watchHubEventSignal}")
		expect strings.Contains(fileModules, "{Event: \"playlist_update\", Signal: watchHubEventSignal}")
		expect strings.Contains(fileModules, "{Event: \"playlist_change\", Signal: watchHubEventSignal}")
		expect strings.Contains(fileModules, "{Event: \"buffer_ready\", Signal: watchHubBufferReadySignal, Direction: \"out\"}")
	}
}

// setConfig/NewHandler mutate package-level global state; other danmuji
// units (e.g. url_ingest_disabled_test.dmj) also call setConfig and auto-run
// in parallel, so this unit must opt out of that auto-parallelization to
// avoid racing on the shared config between NewHandler and ServeHTTP.
@serial
unit "GoSX watch page serves a forward-buffer hlsConfig for the live channel" {
	mounted := newMountedLiveTheatreFixture(t)
	req := httptest.NewRequest(http.MethodGet, DefaultBasePath+"/watch/1", nil)
	rec := httptest.NewRecorder()
	mounted.ServeHTTP(rec, req)
	bodyBytes, readErr := io.ReadAll(rec.Body)
	expect readErr == nil
	html := string(bodyBytes)

	then "holds viewers 8-16s behind the live edge instead of hls.js's near-live defaults" {
		// The random channel runs viewers ~20s behind the produced edge
		// (GOETROPE_RANDOM_CHANNEL_VIEWER_DELAY_SECONDS). hls.js's own
		// defaults target only ~3s behind live, which starves the buffer
		// and amplifies jitter into drops. This asserts the rendered
		// engine props JSON actually carries the wider hlsConfig values
		// (roomSnapshot in data.go), not the shared default hls map.
		expect rec.Code == http.StatusOK
		expect strings.Contains(html, "\"hlsConfig\": {")
		expect strings.Contains(html, "\"lowLatencyMode\": false")
		expect strings.Contains(html, "\"liveSyncDuration\": 8")
		expect strings.Contains(html, "\"liveMaxLatencyDuration\": 16")
		expect strings.Contains(html, "\"maxBufferLength\": 12")
		expect strings.Contains(html, "\"maxMaxBufferLength\": 20")
		expect strings.Contains(html, "\"backBufferLength\": 30")
		expect strings.Contains(html, "\"enableWorker\": true")
		reject strings.Contains(html, "\"hls\": {")
	}
	then "keeps the shared default's ABR and gap-bridging keys instead of silently reverting to hls.js defaults" {
		// hls_config is seeded from a copy of the shared default hls map
		// (roomSnapshot in data.go), not a from-scratch 7-key map, so
		// these keys must survive the merge unchanged:
		//   - capLevelToPlayerSize: hls.js defaults this to false; losing
		//     it lets small players pull the top ABR rung and starve for
		//     bandwidth.
		//   - maxBufferHole: hls.js defaults this to 0.1s; losing it drops
		//     to a value too small to bridge the 0.1-0.5s discontinuities
		//     at 1s mpegts segment joins, so those joins stall+nudge
		//     instead of playing through.
		expect strings.Contains(html, "\"capLevelToPlayerSize\": true")
		expect strings.Contains(html, "\"maxBufferHole\": 0.5")
	}
}

unit "watch runtime emits bounded playback telemetry" {
	runtimeBytes, err := os.ReadFile("public/watch-runtime.js")
	expect err == nil
	runtime := string(runtimeBytes)
	then "correlates stall episodes without blocking recovery" {
		expect strings.Contains(runtime, "var playbackTelemetryEndpoint = \"/api/playback/telemetry\"")
		expect strings.Contains(runtime, "function beginPlaybackStall(video, reason)")
		expect strings.Contains(runtime, "function endPlaybackStall(video, outcome)")
		expect strings.Contains(runtime, "context: playbackTelemetryContext(video)")
		expect strings.Contains(runtime, "mediaID: Math.max(0, Math.floor(toNumber(root && root.dataset.watchReactiveMediaId")
		expect strings.Contains(runtime, "context: episode.context")
		expect strings.Contains(runtime, "media_id: episode.mediaID")
		expect strings.Contains(runtime, "function videoBufferAhead(video)")
		expect strings.Contains(runtime, "function playbackErrorClass(video)")
		expect strings.Contains(runtime, "var videoStalledSignal = \"$video.stalled\"")
		expect strings.Contains(runtime, "scheduleVideoRecovery(video, \"engine_stalled\")")
		expect strings.Contains(runtime, "video._watchRecoveryStalledUnsubscribe()")
		expect strings.Contains(runtime, "emitPlaybackTelemetry(video, \"stall_start\"")
		expect strings.Contains(runtime, "emitPlaybackTelemetry(video, \"stall_end\"")
		expect strings.Contains(runtime, "recordPlaybackRecovery(video, \"recovery_action\", \"play_retry\"")
		expect strings.Contains(runtime, "recordPlaybackRecovery(video, \"recovery_action\", \"source_reload\"")
		expect strings.Contains(runtime, "episode.lastAction === \"source_reload\"")
		reject strings.Contains(runtime, "else if (reloaded)")
		expect strings.Contains(runtime, "keepalive: true")
		expect strings.Contains(runtime, "credentials: \"same-origin\"")
	}
	then "shares one beacon-first sender between stall episodes and periodic quality samples" {
		expect strings.Contains(runtime, "function postPlaybackTelemetry(payload)")
		expect strings.Contains(runtime, "navigator.sendBeacon")
		expect strings.Contains(runtime, "postPlaybackTelemetry(payload)")
		expect strings.Contains(runtime, "var qualitySampleIntervalMs = 60000")
		expect strings.Contains(runtime, "var qualitySampleSequence = 0")
		expect strings.Contains(runtime, "function sendQualitySample(video)")
		expect strings.Contains(runtime, "typeof video.getVideoPlaybackQuality !== \"function\"")
		expect strings.Contains(runtime, "video.getVideoPlaybackQuality()")
		expect strings.Contains(runtime, "\"quality_sample\"")
		expect strings.Contains(runtime, "frames_decoded")
		expect strings.Contains(runtime, "frames_dropped")
		expect strings.Contains(runtime, "track_rebuilds: subtitleTrackRebuilds")
		expect strings.Contains(runtime, "function telemetryMediaID(video)")
		expect strings.Contains(runtime, "function currentRenditionName(video)")
		expect strings.Contains(runtime, "sendQualitySample(video)")
		expect strings.Contains(runtime, "qualitySampleIntervalMs)")
		expect strings.Contains(runtime, "clearInterval(video._watchQualitySampleInterval)")
	}
}
