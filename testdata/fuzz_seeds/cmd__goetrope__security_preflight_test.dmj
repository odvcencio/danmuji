package main

import (
	"context"
	"errors"
	"os"
	"strings"
	"testing"
	"time"

	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/odvcencio/goetrope/pkg/config"
	"github.com/odvcencio/goetrope/pkg/ingest"
	"github.com/odvcencio/goetrope/pkg/transcode"
	"github.com/odvcencio/goetrope/pkg/worker"
	"github.com/spf13/cobra"
)

type serveEmbeddedSpecExecutor struct{}

func newIngestSpecCommand() *cobra.Command {
	cmd := &cobra.Command{}
	cmd.Flags().String("postgres-dsn-source", "", "")
	cmd.Flags().String("path", "", "")
	cmd.Flags().String("url", "", "")
	cmd.Flags().String("policies", "./policies", "")
	return cmd
}

func (serveEmbeddedSpecExecutor) Capabilities() transcode.Capabilities {
	return transcode.Capabilities{
		HasFFmpeg:        true,
		CPUAvailable:     true,
		PreferredBackend: transcode.BackendCPU,
		VideoEncoders:    []string{"libx264"},
	}
}

func (serveEmbeddedSpecExecutor) Execute(context.Context, transcode.Job, worker.ProgressSink) (transcode.Completion, error) {
	return transcode.Completion{Success: true}, nil
}

@serial
unit "serve security preflight ordering" {
	then "invalid security fails before any database dial" {
		originalLoad := serveLoadConfig
		originalConnect := serveConnectWithRetry
		defer func() {
			serveLoadConfig = originalLoad
			serveConnectWithRetry = originalConnect
		}()

		cfg := config.Normalize(config.Defaults())
		cfg.Postgres.DSNSource = "env:GOETROPE_UNUSED_TEST_DSN"
		cfg.Security.MasterKeySource = "env:GOETROPE_UNUSED_TEST_KEY"
		cfg.Server.Listen = "localhost:3000"
		serveLoadConfig = func(*cobra.Command) (config.Config, string, error) {
			return cfg, "", nil
		}
		dialed := false
		serveConnectWithRetry = func(context.Context, []byte, time.Duration) (*pgxpool.Pool, error) {
			dialed = true
			return nil, errors.New("unexpected dial")
		}

		err := runServe(&cobra.Command{}, nil)
		expect err != nil
		reject dialed
	}
}

@serial
unit "serve DNS64 preflight ordering" {
	then "an unknown DNS64 mode fails before credentials or database access" {
		originalLoad := serveLoadConfig
		originalPrepare := servePrepareRuntime
		originalConnect := serveConnectWithRetry
		defer func() {
			serveLoadConfig = originalLoad
			servePrepareRuntime = originalPrepare
			serveConnectWithRetry = originalConnect
		}()

		cfg := config.Defaults()
		cfg.Security.Runtime = config.RuntimeDevelopment
		cfg.Netfetch.DNS64Mode = "discover"
		serveLoadConfig = func(*cobra.Command) (config.Config, string, error) {
			return cfg, "", nil
		}
		prepared := false
		servePrepareRuntime = func(config.Config) (*config.PreparedRuntime, error) {
			prepared = true
			return nil, errors.New("unexpected credential preparation")
		}
		dialed := false
		serveConnectWithRetry = func(context.Context, []byte, time.Duration) (*pgxpool.Pool, error) {
			dialed = true
			return nil, errors.New("unexpected dial")
		}

		err := runServe(&cobra.Command{}, nil)
		expect err != nil
		expect strings.Contains(err.Error(), "netfetch.dns64_mode")
		reject prepared
		reject dialed
	}
}

