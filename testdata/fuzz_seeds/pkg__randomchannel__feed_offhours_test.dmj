package randomchannel

import (
	"context"
	"testing"

	"github.com/odvcencio/arbiter/vm"
	"github.com/odvcencio/goetrope/pkg/library"
	"github.com/odvcencio/goetrope/pkg/theatre"
	"github.com/stretchr/testify/require"
)

unit "Random channel off-hours work suppression" {
	given "an in-progress item after scheduled off-hours begins" {
		queue := &generationQueue{jobs: []int64{10, 20, 99}}
		svc := feedModelTestService(t, true)
		svc.SetTranscodeQueue(queue)
		svc.setFeedPlaylist(PlayoutPlaylist{ItemIDs: []int64{10, 20}, ItemDuration: []float64{600, 600}})
		room := &theatre.Room{RoomCode: RoomCode, Playlist: []int64{10, 20}, CurrentItemIndex: 0}

		when "the deferred in-progress and network-idle ticks run" {
			offHoursRecovered, offHoursErr := svc.driveFeedSchedulerWhenActive(context.Background(), room, 100, true, false)
			idleRecovered, idleErr := svc.driveFeedSchedulerWhenActive(context.Background(), room, 100, false, true)

			then "does not enqueue or reconcile any live-cache work" {
				require.NoError(t, offHoursErr)
				require.NoError(t, idleErr)
				require.False(t, offHoursRecovered)
				require.False(t, idleRecovered)
				require.Equal(t, 0, queue.splitCalls)
				require.Equal(t, 0, queue.pruneCalls)
			}
		}

		when "entering scheduled idle" {
			svc.cancelAllLiveCacheWork("scheduled off-hours")

			then "cancels every remaining live-cache generation" {
				require.Equal(t, 1, queue.pruneCalls)
				require.Len(t, queue.kept, 0)
				require.Equal(t, 3, queue.cancelled)
			}
		}
	}

	given "a full Tick repeatedly preserving an in-progress off-hours movie then restoring idle" {
		queue := &generationQueue{jobs: []int64{10, 20, 99}}
		room := &theatre.Room{RoomCode: RoomCode, Playlist: []int64{10, 20}, CurrentItemIndex: 0}
		manager := &recoveryRoomManager{room: room}
		svc := feedModelTestService(t, true)
		svc.store = &library.Store{}
		svc.manager = manager
		svc.loadItem = func(_ context.Context, id int64) (*library.MediaItem, error) {
			return &library.MediaItem{ID: id, DurationMs: 600_000}, nil
		}
		svc.warmItem = func(context.Context, *library.MediaItem) {}
		svc.engine = fixedPolicyEngine{actions: []vm.MatchedRule{{Action: "PreserveQueueDuringOffHours"}}}
		svc.SetTranscodeQueue(queue)
		offHours := true
		networkIdle := false
		svc.tickFacts = func(context.Context, *theatre.Room) (map[string]any, float64, error) {
			return map[string]any{
				"schedule.off_hours_active": offHours,
				"channel.network_idle": networkIdle,
				"channel.authoritative_clock_present": true,
				"channel.playing": true,
			}, 100, nil
		}

		when "two preserve ticks and one restored-idle tick cross the boundary" {
			errOne := svc.Tick(context.Background())
			errTwo := svc.Tick(context.Background())
			offHours = false
			networkIdle = true
			errThree := svc.Tick(context.Background())
			svc.stopBitmapSubtitleSweep()

			then "every Tick cancels all live-cache work without issuing replacements" {
				require.NoError(t, errOne)
				require.NoError(t, errTwo)
				require.NoError(t, errThree)
				require.Equal(t, 3, queue.pruneCalls)
				require.Len(t, queue.kept, 0)
				require.Equal(t, 0, queue.splitCalls)
				require.Equal(t, 0, manager.advances)
			}
		}
	}
}
